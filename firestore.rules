rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsGame(gameUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/games/$(gameUid))
        && get(/databases/$(database)/documents/games/$(gameUid)).data.creatorId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan == 'free');
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spinsRemaining', 'spinPeriod', 'plan'])
        && (request.resource.data.get('spinPeriod', '') != resource.data.get('spinPeriod', '')
          || request.resource.data.get('spinsRemaining', 0) <= resource.data.get('spinsRemaining', 0));

    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    match /games/{gameId} {
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if signedIn()
        && resource.data.creatorId == request.auth.uid;
    }

    match /participants/{participantId} {
      allow read: if ownsGame(resource.data.gameUid);
      allow create: if ownsGame(request.resource.data.gameUid)
        || (signedIn()
          && request.resource.data.userId == request.auth.uid
          && exists(/databases/$(database)/documents/games/$(request.resource.data.gameUid)));
      allow update: if ownsGame(request.resource.data.gameUid);
      allow delete: if ownsGame(resource.data.gameUid);
    }

    match /invitations/{invitationId} {
      allow create: if ownsGame(request.resource.data.gameUid);
      allow read: if ownsGame(resource.data.gameUid);
    }

    match /history/{historyId} {
      allow read: if ownsGame(resource.data.gameUid);
      allow create, update: if ownsGame(request.resource.data.gameUid);
    }

    match /winners/{winnerId} {
      allow read: if ownsGame(resource.data.gameUid);
      allow create, update: if ownsGame(request.resource.data.gameUid);
    }

  }
}
