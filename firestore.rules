rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsGame(gameUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/games/$(gameUid))
        && get(/databases/$(database)/documents/games/$(gameUid)).data.creatorId == request.auth.uid;
    }

    function validProfileUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['fullName', 'nickname', 'phoneNumber', 'firstName', 'lastName'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 40
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 32;
    }

    function validUsageUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['spinsRemaining', 'spinPeriod', 'plan', 'playersCount'])
        && request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free')
        && (!changedKeys.hasAny(['playersCount']) || request.resource.data.get('playersCount', 0) <= 200)
        && (request.resource.data.get('spinPeriod', '') != resource.data.get('spinPeriod', '')
          || request.resource.data.get('spinsRemaining', 0) <= resource.data.get('spinsRemaining', 0));
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan == 'free');
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && (validProfileUpdate() || validUsageUpdate());

    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    match /coupons/{couponId} {
      allow read: if signedIn()
        && resource.data.couponCode == couponId;
      allow write: if false;
    }

    match /games/{gameId} {
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if signedIn()
        && resource.data.creatorId == request.auth.uid;
    }

    match /participants/{participantId} {
      allow read: if ownsGame(resource.data.gameUid)
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if ownsGame(request.resource.data.gameUid)
        || (signedIn()
          && request.resource.data.userId == request.auth.uid
          && exists(/databases/$(database)/documents/games/$(request.resource.data.gameUid)));
      allow update: if ownsGame(request.resource.data.gameUid);
      allow delete: if ownsGame(resource.data.gameUid);
    }

    match /invitations/{invitationId} {
      allow create: if ownsGame(request.resource.data.gameUid);
      allow read: if ownsGame(resource.data.gameUid);
    }

    match /history/{historyId} {
      allow read: if ownsGame(resource.data.gameUid);
      allow create, update: if ownsGame(request.resource.data.gameUid);
    }

    match /winners/{winnerId} {
      allow read: if ownsGame(resource.data.gameUid);
      allow create, update: if ownsGame(request.resource.data.gameUid);
    }

  }
}
